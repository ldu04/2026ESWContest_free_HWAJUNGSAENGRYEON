// secrets.h.example — 메시 인증정보 템플릿
//
// ★ 이 파일을 **secrets.h 로 복사**한 뒤 값을 채워 쓴다.
//     cp firmware/node/secrets.h.example firmware/node/secrets.h
//   secrets.h 는 .gitignore 에 있어 커밋되지 않는다.
//
// 왜 분리했나:
//   메시 비밀번호가 소스에 박혀 있으면 저장소를 Public 으로 공개하는 순간 함께 공개된다.
//   같은 SSID/비번으로 누구나 메시에 참여할 수 있고, 노드를 사칭해 **가짜 사망 패킷**을
//   넣으면 시연이 깨진다. "결선 전에 바꾸자"는 반드시 잊힌다 — 구조로 막는다.
//
// ※ 이 파일은 firmware/node/ 안에 있어야 한다. Arduino 는 스케치 폴더의 헤더만 찾고,
//   빌드 시 이 폴더가 통째로 영문 경로로 복사되기 때문이다(BUILD.md 함정 ④).

#pragma once

#define MESH_PREFIX     "CHANGE-ME-mesh"
#define MESH_PASSWORD   "CHANGE-ME-password"
#define MESH_PORT       5555
